rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrators, by the email on their Firebase Auth token. Keep this in
    // step with ADMIN_EMAILS in functions/index.js and admin.html.
    function isAdmin() {
      return request.auth != null && (
               request.auth.token.admin == true ||
               (request.auth.token.email != null &&
                request.auth.token.email.lower() in ['ramon@seacoastrvip.com'])
             );
    }

    // ─────────────────────────────────────────────────────────────
    // iOS APP RULES (unchanged — do not edit)
    // These collections use real Firebase Auth (UID-based).
    // ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null && request.auth.uid == userId;
    }

    match /drivers/{driverId} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null && request.auth.uid == driverId;

      match /complianceDocuments/{docType} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == driverId;
      }
      match /payouts/{weekKey} {
        allow read:  if request.auth != null && request.auth.uid == driverId;
        allow write: if false;
      }
    }

    match /rides/{rideId} {
      allow read:   if request.auth != null && (
                       resource == null ||
                       request.auth.uid == resource.data.riderId ||
                       request.auth.uid == resource.data.driverId ||
                       resource.data.status == 'pending'
                    );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.riderId;
      allow update: if request.auth != null && (
                       request.auth.uid == resource.data.riderId ||
                       request.auth.uid == resource.data.driverId ||
                       resource.data.driverId == 'none'
                    );
      match /messages/{msgId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      }
    }

    match /pings/{userId} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null;
    }

    match /_meta/{any} {
      allow read: if true;
      allow write: if false;
    }

    match /__warmup/{any} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // WEBSITE RULES (open — website pages don't sign in with Auth)
    // ─────────────────────────────────────────────────────────────

    match /bookings/{docId} {
      allow read, write: if true;
    }

    // Corporate accounts. A password must NEVER be written onto these documents
    // — they are client-readable, so a plaintext field here is public. Sign-in
    // goes through the corporateLogin Cloud Function, which compares a bcrypt
    // hash in corporate_auth below. These rules reject any write that would
    // (re)introduce a password field, so an old build cannot repopulate it.
    match /corporate_accounts/{docId} {
      allow read:   if true;
      allow create: if !('password' in request.resource.data);
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['password'])
                    || !('password' in request.resource.data);
      allow delete: if true;
    }

    // Hashed corporate passwords — clients can NEVER read or write this.
    // Only Cloud Functions (Admin SDK) touch it.
    match /corporate_auth/{docId} {
      allow read, write: if false;
    }

    // Personal clients. Same rule as corporate_accounts: these documents are
    // client-readable, so a password must never be written onto one. Sign-in
    // goes through the clientLogin Cloud Function against client_auth below.
    match /clients/{clientId} {
      allow read:   if true;
      allow create: if !('password' in request.resource.data);
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['password'])
                    || !('password' in request.resource.data);
      allow delete: if true;

      match /trips/{tripId} {
        allow read, write: if true;
      }
    }

    // Hashed client passwords — clients can NEVER read or write this.
    // Only Cloud Functions (Admin SDK) touch it.
    match /client_auth/{docId} {
      allow read, write: if false;
    }

    match /trips/{docId} {
      allow read, write: if true;
    }

    match /client_trips/{docId} {
      allow read, write: if true;
    }

    match /quotes/{docId} {
      allow read, write: if true;
    }

    match /invoices/{docId} {
      allow read, write: if true;
    }

    // Only admin.html touches these, and it now signs in with Firebase Auth,
    // so this one can be closed properly.
    match /admin_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /estimates/{docId} {
      allow read, write: if true;
    }

    match /mail/{mailId} {
      allow read:   if false;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }
  }
}
