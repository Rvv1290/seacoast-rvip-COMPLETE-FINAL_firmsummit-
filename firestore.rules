rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // iOS APP RULES (unchanged — do not edit)
    // These collections use real Firebase Auth (UID-based).
    // ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null && request.auth.uid == userId;
    }

    match /drivers/{driverId} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null && request.auth.uid == driverId;

      match /complianceDocuments/{docType} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == driverId;
      }
      match /payouts/{weekKey} {
        allow read:  if request.auth != null && request.auth.uid == driverId;
        allow write: if false;
      }
    }

    match /rides/{rideId} {
      allow read:   if request.auth != null && (
                       resource == null ||
                       request.auth.uid == resource.data.riderId ||
                       request.auth.uid == resource.data.driverId ||
                       resource.data.status == 'pending'
                    );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.riderId;
      allow update: if request.auth != null && (
                       request.auth.uid == resource.data.riderId ||
                       request.auth.uid == resource.data.driverId ||
                       resource.data.driverId == 'none'
                    );
      match /messages/{msgId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      }
    }

    match /pings/{userId} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null;
    }

    match /_meta/{any} {
      allow read: if true;
      allow write: if false;
    }

    match /__warmup/{any} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // WEBSITE RULES (open — website pages don't sign in with Auth)
    // ─────────────────────────────────────────────────────────────

    match /bookings/{docId} {
      allow read, write: if true;
    }

    match /corporate_accounts/{docId} {
      allow read, write: if true;
    }

    match /clients/{clientId} {
      allow read, write: if true;

      match /trips/{tripId} {
        allow read, write: if true;
      }
    }

    match /trips/{docId} {
      allow read, write: if true;
    }

    match /client_trips/{docId} {
      allow read, write: if true;
    }

    match /quotes/{docId} {
      allow read, write: if true;
    }

    match /invoices/{docId} {
      allow read, write: if true;
    }

    match /mail/{mailId} {
      allow read:   if false;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }
  }
}
