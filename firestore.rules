rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // iOS APP RULES (unchanged — do not edit)
    // These collections use real Firebase Auth (UID-based).
    // ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null && request.auth.uid == userId;
    }

    match /drivers/{driverId} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null && request.auth.uid == driverId;

      match /complianceDocuments/{docType} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == driverId;
      }
      match /payouts/{weekKey} {
        allow read:  if request.auth != null && request.auth.uid == driverId;
        allow write: if false;
      }
    }

    match /rides/{rideId} {
      allow read:   if request.auth != null && (
                       resource == null ||
                       request.auth.uid == resource.data.riderId ||
                       request.auth.uid == resource.data.driverId ||
                       resource.data.status == 'pending'
                    );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.riderId;
      allow update: if request.auth != null && (
                       request.auth.uid == resource.data.riderId ||
                       request.auth.uid == resource.data.driverId ||
                       resource.data.driverId == 'none'
                    );
      match /messages/{msgId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      }
    }

    match /pings/{userId} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null;
    }

    match /_meta/{any} {
      allow read: if true;
      allow write: if false;
    }

    match /__warmup/{any} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // WEBSITE RULES
    // Every website page signs in anonymously on load, so we require
    // request.auth != null everywhere. This blocks random internet
    // traffic that hasn't opened the site.
    //
    // TIP: Enable Firebase Authentication → Sign-in method →
    // "Anonymous" in the Firebase console for these to work.
    // ─────────────────────────────────────────────────────────────

    // Corporate accounts — read/write require an auth token.
    // Delete restricted so a scraper with an anon token cannot wipe rows.
    match /corporate_accounts/{accountId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Website bookings.
    match /bookings/{bookingId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Client accounts (account.html signup / sign-in flow).
    match /clients/{clientId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;

      match /trips/{tripId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if request.auth != null;
      }
    }

    // Quote requests (quote.html → admin.html).
    match /quotes/{quoteId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Firebase "Trigger Email" extension queue. Create-only.
    match /mail/{mailId} {
      allow read:   if false;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    // Shared trips collection.
    match /trips/{tripId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
