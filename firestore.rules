rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // An iOS app or admin session — any signed-in caller that is NOT a portal
    // customer. The app rules below used to say `request.auth != null`, which
    // was equivalent while the portals had no Firebase Auth identity at all.
    // Now that they do, the app's collections have to exclude them explicitly,
    // or every portal customer could read every app user, driver and ride.
    // App and admin tokens carry no `portal` claim, so their access is
    // unchanged.
    function isAppUser() {
      return request.auth != null && request.auth.token.portal == null;
    }

    // Administrators, by the email on their Firebase Auth token. Keep this in
    // step with ADMIN_EMAILS in functions/index.js and admin.html.
    function isAdmin() {
      return request.auth != null && (
               request.auth.token.admin == true ||
               (request.auth.token.email != null &&
                request.auth.token.email.lower() in ['ramon@seacoastrvip.com'])
             );
    }

    // ─────────────────────────────────────────────────────────────
    // iOS APP RULES (unchanged — do not edit)
    // These collections use real Firebase Auth (UID-based).
    // ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read:   if isAppUser();
      allow write:  if isAppUser() && request.auth.uid == userId;
    }

    match /drivers/{driverId} {
      allow read:   if isAppUser();
      allow write:  if isAppUser() && request.auth.uid == driverId;

      match /complianceDocuments/{docType} {
        allow read:  if isAppUser();
        allow write: if isAppUser() && request.auth.uid == driverId;
      }
      match /payouts/{weekKey} {
        allow read:  if isAppUser() && request.auth.uid == driverId;
        allow write: if false;
      }
    }

    match /rides/{rideId} {
      allow read:   if isAppUser() && (
                       resource == null ||
                       request.auth.uid == resource.data.riderId ||
                       request.auth.uid == resource.data.driverId ||
                       resource.data.status == 'pending'
                    );
      allow create: if isAppUser() && request.auth.uid == request.resource.data.riderId;
      allow update: if isAppUser() && (
                       request.auth.uid == resource.data.riderId ||
                       request.auth.uid == resource.data.driverId ||
                       resource.data.driverId == 'none'
                    );
      match /messages/{msgId} {
        allow read:   if isAppUser();
        allow create: if isAppUser() && request.auth.uid == request.resource.data.senderId;
      }
    }

    match /pings/{userId} {
      allow read:  if isAppUser() && request.auth.uid == userId;
      allow write: if isAppUser();
    }

    match /_meta/{any} {
      allow read: if true;
      allow write: if false;
    }

    match /__warmup/{any} {
      allow read: if isAppUser();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // WEBSITE RULES (open — website pages don't sign in with Auth)
    // ─────────────────────────────────────────────────────────────

    // Bookings were readable by anyone on the internet. They are now limited
    // to signed-in callers, which since the portals took up Firebase Auth
    // means customers, drivers, the apps and admin.
    //
    // Owner-only: a customer sees their own bookings and nothing else. Of the
    // 81 bookings in the database, 77 already carry a clientId or a
    // corporateAccountId; the four that carry neither match no client record
    // and are visible to admin only.
    //
    // Drivers are allowed through because driver-portal.html lists available
    // rides with an unfiltered query, which cannot be expressed as ownership.
    //
    // `create` stays open for the public booking form on schedule.html, which
    // submits before anyone signs in. `update` matches read: drivers are
    // included because accepting and completing a ride is an update to a
    // booking they do not own.
    match /bookings/{docId} {
      allow read:   if isAdmin() || isDriver() || ownsBooking();
      allow create: if true;
      allow update: if isAdmin() || isDriver() || ownsBooking();
      allow delete: if isAdmin();
    }

    function ownsBooking() {
      return request.auth != null && (
               (request.auth.token.clientId != null
                && resource.data.get('clientId', '') == request.auth.token.clientId) ||
               (request.auth.token.accountId != null
                && resource.data.get('corporateAccountId', '') == request.auth.token.accountId)
             );
    }

    // A driver signed in through driver-portal.html. Costs one document read
    // per rule evaluation, which is why it is only used where it is needed.
    function isDriver() {
      return request.auth != null
             && exists(/databases/$(database)/documents/drivers/$(request.auth.uid));
    }

    // Corporate accounts. A password must NEVER be written onto these documents
    // — they are client-readable, so a plaintext field here is public. Sign-in
    // goes through the corporateLogin Cloud Function, which compares a bcrypt
    // hash in corporate_auth below. These rules reject any write that would
    // (re)introduce a password field, so an old build cannot repopulate it.
    // `create` stays open because corporate.html's public application form
    // writes the new account document itself. Reads and updates are now the
    // account's own portal session or an admin.
    //
    // NOTE: schedule.html lists every Approved/Active corporate account to
    // fill a dropdown, with nobody signed in. That query is denied by this
    // rule, so it has to be reworked before /schedule is reopened.
    match /corporate_accounts/{docId} {
      allow read:   if isAdmin() || (request.auth != null && request.auth.token.accountId == docId);
      allow create: if !('password' in request.resource.data);
      allow update: if (isAdmin() || (request.auth != null && request.auth.token.accountId == docId))
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['password'])
                        || !('password' in request.resource.data));
      allow delete: if isAdmin();
    }

    // Hashed corporate passwords — clients can NEVER read or write this.
    // Only Cloud Functions (Admin SDK) touch it.
    match /corporate_auth/{docId} {
      allow read, write: if false;
    }

    // A portal customer acting on their own client record.
    function isThisClient(clientId) {
      return request.auth != null && request.auth.token.clientId == clientId;
    }

    // Personal clients. A password must never be written onto one of these —
    // they are readable, so a plaintext field here would be public. Sign-in
    // goes through the clientLogin Cloud Function against client_auth below.
    //
    // Reads are the account's own record or an admin. Looking a client up by
    // email or phone before sign-in now goes through the clientLookup Cloud
    // Function, which answers only for the identifier supplied — reading this
    // collection used to be open, which exposed every customer's name, email,
    // phone, address and balance to anyone holding the API key.
    match /clients/{clientId} {
      allow read:   if isAdmin()
                    || isThisClient(clientId)
                    || (request.auth != null && resource.data.firebaseUid == request.auth.uid);
      allow create: if !('password' in request.resource.data);
      // The email-link flow links a Firebase uid to the client record while
      // signed in but before a portal token exists, so that one field is
      // allowed on its own.
      allow update: if (isAdmin()
                        || isThisClient(clientId)
                        || (request.auth != null
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys().hasOnly(['firebaseUid'])))
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['password'])
                        || !('password' in request.resource.data));
      allow delete: if isAdmin();

      // Every trip lives here, under its own client — the top-level `trips`
      // collection is unused.
      match /trips/{tripId} {
        allow read, write: if isAdmin() || isThisClient(clientId);
      }
    }

    // Hashed client passwords — clients can NEVER read or write this.
    // Only Cloud Functions (Admin SDK) touch it.
    match /client_auth/{docId} {
      allow read, write: if false;
    }

    // Failed sign-in counters behind the login throttle. If this were
    // writable, the throttle could be cleared by the thing it limits.
    match /auth_throttle/{docId} {
      allow read, write: if false;
    }

    // Unused — no page in the repo reads or writes a top-level trip; they all
    // live under clients/{clientId}/trips.
    match /trips/{docId} {
      allow read, write: if isAdmin();
    }

    // No page in this repo reads or writes client_trips or invoices — the
    // portals' "invoices" views are built from bookings. Closed to admin only
    // rather than deleted, in case a future tool needs them.
    match /client_trips/{docId} {
      allow read, write: if isAdmin();
    }

    match /invoices/{docId} {
      allow read, write: if isAdmin();
    }

    // Only admin.html touches these two, and they hold prospect contact
    // details and pricing, so they were worth closing.
    match /quotes/{docId} {
      allow read, write: if isAdmin();
    }

    // Only admin.html touches these, and it now signs in with Firebase Auth,
    // so this one can be closed properly.
    match /admin_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /estimates/{docId} {
      allow read, write: if isAdmin();
    }

    match /mail/{mailId} {
      allow read:   if false;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }
  }
}
